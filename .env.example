# Copy to .env at the repo root. Bun loads it via --env-file, Vite via envDir.

# Server
PORT=3001
# Local file now; a libsql://... URL when this moves to Turso.
# `file:` paths are relative to THIS directory (the repo root), whichever
# process reads them -- the server and drizzle-kit run from different cwds.
DATABASE_URL=file:./packages/server/aw.db
